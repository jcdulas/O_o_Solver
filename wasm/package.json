{
  "name": "oos-solver",
  "version": "0.2.0",
  "description": "Linear finite element solver (statics, normal modes, buckling) for models read by oor-reader, in WebAssembly.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "build-info.js",
    "index.js",
    "index.d.ts",
    "optimization.js",
    "optimization.d.ts",
    "oos_solver_core.wasm",
    "oos_solver_core*.js",
    "oos_solver_core*.mjs"
  ],
  "peerDependencies": {
    "oor-reader": ">=0.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
